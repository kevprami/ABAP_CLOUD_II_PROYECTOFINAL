projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_DT_INCT_KPM alias Incident
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use action changeStatus;

  use association _History {  with draft; }
}

define behavior for ZC_DT_INCT_H_KPM alias History
{
  use update;
  use delete;

  use association _Incident { with draft; }
}